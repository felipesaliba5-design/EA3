      "parameters": {
        "jsCode": "// Recebe a lista de artigos direto do HTTP Request (sem depender de credenciais do GitHub)\nlet data = $input.all().map(i => i.json);\nif (Array.isArray(data[0])) data = data[0];\n\nreturn data.map((a, i) => ({\n  json: {\n    id: i + 1,\n    titulo: a.titulo,\n    autor: a.autor,\n    ano: a.ano,\n    link_pdf: a.url_pdf\n  }\n}));"
      },
